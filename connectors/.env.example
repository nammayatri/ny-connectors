PORT=3000
WEBHOOK_URL=https://your-service.example.com/incoming
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# --- FRFS ticketing (metro / bus / suburban rail) ---
# Turn the "Metro/Bus Ticket" menu item on or off (default: on)
FRFS_ENABLED=true
# City name used by /frfs/* — a plain name like "Chennai", NOT a std: code.
# Leave blank to derive it from the user's location.
NY_FRFS_CITY=
# Confirms tickets via ?isMockPayment=true, skipping real checkout.
# For sandbox/pilot testing only — never set this in production.
FRFS_MOCK_PAYMENT=false

# --- Multimodal journeys ---
# Offers public-transport journeys alongside taxi estimates (default: on)
MULTIMODAL_ENABLED=true
