# --- Server ---
PORT=3000

# --- WhatsApp (Meta Cloud API) — required to receive + send ---
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret            # verifies inbound webhook HMAC
WHATSAPP_ACCESS_TOKEN=your-graph-api-token      # sends outbound messages
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Dev-only: skip inbound webhook signature verification. NEVER enable in prod.
# WHATSAPP_SKIP_VERIFY=0

# --- Namma Yatri API ---
NY_BASE_URL=https://api.moving.tech/pilot/app/v2
NY_AUTH_URL=https://api.moving.tech/pilot/app/v2
NY_PRE_AUTH_TOKEN=your-internal-auth-token      # silent getToken auth for existing riders
NY_MERCHANT_ID=your-ny-merchant-id
NY_DASHBOARD_URL=https://dashboard.moving.tech/api/bap
NY_DASHBOARD_TOKEN=your-dashboard-token         # new-user OTP registration
NY_DASHBOARD_MERCHANT=NAMMA_YATRI
NY_CITY=std:080

# Dev: replace the NY client with an in-memory mock (no real calls / dispatch).
# NY_MOCK=1
# NY_LOG_BODIES=1        # log request/response bodies (PII) — disable in prod
# NY_LOG_PRETTY=1        # pretty-print those bodies (set 0 for single-line prod logs)

# --- Access control ---
# Comma-separated 10-digit allowlist for the live flow; others get "coming soon".
# Set empty (ALLOWED_PHONES=) to open to everyone.
ALLOWED_PHONES=9361176218

# --- Ride mode ---
# Which ride types this deployment offers: flexi | regular | both.
RIDE_MODE=both
# Quick Ride (internally "flexi") is booked via NY's EasyBooking product: a
# destination-less metered ride whose fare is computed server-side from actual GPS
# distance. There is no local fare tariff to configure — the rider is shown the
# quote's server-provided starting fare. Only the service geofence is configurable:
FLEXI_SERVICE_AREA=Tumkur
FLEXI_SERVICE_RADIUS_KM=15
# FLEXI_INTRO_VIDEO_URL=https://.../how-to-book.mp4
# FLEXI_SUPPORT_PHONE=+91 80000 00000
# Background ride tracker (arrived → started → ended pushes):
# FLEXI_TRACK_ENABLED=true
# FLEXI_TRACK_POLL_SEC=3
# FLEXI_TRACK_MAX_AGE_MIN=180

# --- Redis (optional; falls back to in-memory when unset) ---
# REDIS_URL=redis://localhost:6379
# SESSION_TTL_SECONDS=1800

# --- Multi-merchant (optional) ---
# Each merchant is configured with MERCHANT_{ID}_{FIELD}, e.g.:
# MERCHANT_TUMKUR_WHATSAPP_PHONE_NUMBER_ID=...
# MERCHANT_TUMKUR_WHATSAPP_ACCESS_TOKEN=...
# MERCHANT_TUMKUR_WHATSAPP_APP_SECRET=...
# MERCHANT_TUMKUR_RIDE_MODE=both
# MERCHANT_TUMKUR_NY_PRE_AUTH_TOKEN=...
# MERCHANT_TUMKUR_NY_MERCHANT_ID=...
